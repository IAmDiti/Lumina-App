# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Used for email confirmation redirects when the Origin header is missing
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic (server-only; never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional: override the Active Listener model (default: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: max journal entries per user per 24h (default: 100)
# LUMINA_DAILY_ENTRY_LIMIT=100
