# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Used for email confirmation redirects when the Origin header is missing
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase service role key (Project Settings -> API -> service_role, or the
# new "secret" key). Server-only, never prefix with NEXT_PUBLIC_. Used by the
# Lemon Squeezy webhook, the sandbox/feedback endpoints and the admin
# feedback view; bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed into /admin/feedback. Must match a real
# account's sign-up email exactly.
ADMIN_EMAILS=you@example.com

# Anthropic (server-only; never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# Optional: override the model used per plan. Paid defaults to a stronger
# model with more reasoning effort — that gap is part of what Paid is worth
# paying for, on top of memory.
# ANTHROPIC_MODEL_FREE=claude-sonnet-5
# ANTHROPIC_MODEL_PAID=claude-opus-5

# Lemon Squeezy (billing). Create two variants of the Paid product — monthly
# ($8.99) and annual ($86.99/yr) — under Store -> Products for their variant
# ids; Settings -> Webhooks to create the endpoint
# (https://<your-domain>/api/webhooks/lemonsqueezy, subscribed to
# subscription_* events) and get the signing secret. The displayed prices in
# src/lib/lumina/checkout.ts must match whatever you set on these variants.
LEMONSQUEEZY_STORE_URL=https://your-store.lemonsqueezy.com
LEMONSQUEEZY_VARIANT_ID_MONTHLY=
LEMONSQUEEZY_VARIANT_ID_ANNUAL=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Settings -> API, "+ Create API key". Used only to cancel a paid user's
# subscription when they delete their account from /settings, so they don't
# keep getting billed after their data is gone.
LEMONSQUEEZY_API_KEY=

# Optional: daily reflection limits per plan (defaults: free=3, paid=unlimited)
# LUMINA_FREE_DAILY_LIMIT=3
# LUMINA_PAID_DAILY_LIMIT=100

# OpenAI (server-only; never prefix with NEXT_PUBLIC_). Powers Voice Talk —
# recorded audio is transcribed via OpenAI's speech-to-text, not Anthropic
# (Claude has no audio input). platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: override the transcription model (default: gpt-4o-transcribe)
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Optional: free-plan daily voice transcriptions (default: 10); paid is unlimited
# LUMINA_FREE_DAILY_VOICE_LIMIT=10
